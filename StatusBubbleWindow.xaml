<Window x:Class="GuguPet.StatusBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咕嘎任务进度"
        Width="410" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BubbleInk" Color="#292A28" />
        <SolidColorBrush x:Key="BubbleCream" Color="#FFFDF8" />
        <SolidColorBrush x:Key="BubbleOrange" Color="#F5A623" />
        <SolidColorBrush x:Key="BubbleCyan" Color="#26AFC2" />
        <DrawingBrush x:Key="DshWaveHorizontal" TileMode="Tile"
                      Viewport="0,0,18,8" ViewportUnits="Absolute"
                      Viewbox="0,0,18,8" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0,4 C 2,0 7,0 9,4 C 11,8 16,8 18,4">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#278ED8" Thickness="2.2"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="DshWaveVertical" TileMode="Tile"
                      Viewport="0,0,8,18" ViewportUnits="Absolute"
                      Viewbox="0,0,8,18" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 4,0 C 0,2 0,7 4,9 C 8,11 8,16 4,18">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#278ED8" Thickness="2.2"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="CodexDashHorizontal" TileMode="Tile"
                      Viewport="0,0,16,6" ViewportUnits="Absolute"
                      Viewbox="0,0,16,6" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 1,3 L 10,3">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#26AFC2" Thickness="2.2"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="CodexDashVertical" TileMode="Tile"
                      Viewport="0,0,6,16" ViewportUnits="Absolute"
                      Viewbox="0,0,6,16" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 3,1 L 3,10">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#26AFC2" Thickness="2.2"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#C9C3BA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonUp="Bubble_OnMouseLeftButtonUp" Margin="0,6,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
        </Grid.RowDefinitions>

        <Border x:Name="BubbleFrame" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="48,0,0,0" Background="{StaticResource BubbleInk}"
                BorderBrush="#111211" BorderThickness="1" CornerRadius="18" Padding="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.27" />
            </Border.Effect>
            <Border Background="{StaticResource BubbleCream}" CornerRadius="15" Padding="68,12,14,11">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource BubbleCyan}"
                                 Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" Grid.Column="1" Text="Codex 正在工作"
                                   FontWeight="SemiBold" Foreground="#292A28" FontSize="13" />
                        <Grid Grid.Column="2" Width="30" Height="24">
                            <Border x:Name="CodexSourceIcon" Background="#21383B" BorderBrush="#26AFC2"
                                    BorderThickness="1" CornerRadius="7">
                                <TextBlock Text="&gt;_" Foreground="#EAFBFC" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </Border>
                            <Border x:Name="DshSourceIcon" Background="#0B1830" BorderBrush="#278ED8"
                                    BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="D" Foreground="#F1F7FF" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="4" Height="4" Fill="#35B9E6" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,4,4,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border x:Name="BubbleAccentBar" Height="3" Background="{StaticResource BubbleCyan}"
                            CornerRadius="2" Margin="0,8,0,8" />

                    <TextBlock x:Name="TaskTitleText" TextWrapping="Wrap"
                               FontWeight="SemiBold" FontSize="12" Foreground="#292A28"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText" Margin="0,5,0,0" TextWrapping="Wrap"
                               MaxWidth="298" FontSize="12" Foreground="#575651" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TaskNavigation" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="‹" Width="27" Height="24" Padding="0" Click="PreviousTask_OnClick" />
                            <TextBlock x:Name="TaskCounterText" Margin="7,0" VerticalAlignment="Center"
                                       FontSize="10" Foreground="#77736D" />
                            <Button Content="›" Width="27" Height="24" Padding="0" Click="NextTask_OnClick" />
                        </StackPanel>
                        <TextBlock x:Name="ActionHintText" Grid.Column="1" Text="点击气泡返回 Codex" Margin="9,0"
                                   VerticalAlignment="Center" FontSize="10" Foreground="#817D76" />
                        <Button x:Name="ActionButton" Grid.Column="2" Content="返回 Codex"
                                Visibility="Collapsed" Padding="11,5" Foreground="White"
                                Background="{StaticResource BubbleOrange}" BorderBrush="#DF8D15"
                                FontWeight="SemiBold" Click="ActionButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Rectangle x:Name="DshWaveTop" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="8" Margin="110,3,7,0" VerticalAlignment="Top"
                   Fill="{StaticResource DshWaveHorizontal}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />
        <Rectangle x:Name="DshWaveBottom" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="8" Margin="110,0,7,3" VerticalAlignment="Bottom"
                   Fill="{StaticResource DshWaveHorizontal}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />
        <Rectangle x:Name="DshWaveRight" Grid.Column="0" Grid.ColumnSpan="2"
                   Width="8" Margin="0,9,1,9" HorizontalAlignment="Right"
                   Fill="{StaticResource DshWaveVertical}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />
        <Rectangle x:Name="CodexBorderTop" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="6" Margin="110,4,7,0" VerticalAlignment="Top"
                   Fill="{StaticResource CodexDashHorizontal}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />
        <Rectangle x:Name="CodexBorderBottom" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="6" Margin="110,0,7,4" VerticalAlignment="Bottom"
                   Fill="{StaticResource CodexDashHorizontal}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />
        <Rectangle x:Name="CodexBorderRight" Grid.Column="0" Grid.ColumnSpan="2"
                   Width="6" Margin="0,9,2,9" HorizontalAlignment="Right"
                   Fill="{StaticResource CodexDashVertical}" IsHitTestVisible="False"
                   Panel.ZIndex="3" Visibility="Collapsed" />

        <Border Grid.Column="0" Width="104" Height="116" Margin="0,0,-26,-2"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background>
                <ImageBrush ImageSource="Assets/gugu-icon-cutout.png" Stretch="UniformToFill"
                            Viewbox="0.18,0,0.64,0.76" ViewboxUnits="RelativeToBoundingBox" AlignmentY="Top" />
            </Border.Background>
        </Border>

        <Path Grid.Row="1" Grid.Column="1" Fill="{StaticResource BubbleInk}"
              Data="M 155,0 L 183,0 L 169,14 Z" HorizontalAlignment="Left" Margin="72,-1,0,0" />
        <Path Grid.Row="1" Grid.Column="1" Fill="{StaticResource BubbleOrange}"
              Data="M 159,0 L 179,0 L 169,10 Z" HorizontalAlignment="Left" Margin="72,-1,0,0" />
    </Grid>
</Window>
