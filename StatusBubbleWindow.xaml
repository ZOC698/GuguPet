<Window x:Class="GuguPet.StatusBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咕嘎任务进度"
        Width="410" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BubbleInk" Color="#292A28" />
        <SolidColorBrush x:Key="BubbleCream" Color="#FFFDF8" />
        <SolidColorBrush x:Key="BubbleOrange" Color="#F5A623" />
        <SolidColorBrush x:Key="BubbleCyan" Color="#26AFC2" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#C9C3BA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonUp="Bubble_OnMouseLeftButtonUp" Margin="0,6,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
        </Grid.RowDefinitions>

        <Border x:Name="BubbleFrame" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="48,0,0,0" Background="{StaticResource BubbleInk}"
                BorderBrush="#111211" BorderThickness="1" CornerRadius="18" Padding="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.27" />
            </Border.Effect>
            <Border Background="{StaticResource BubbleCream}" CornerRadius="15" Padding="68,12,14,11">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource BubbleCyan}"
                                 Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" Grid.Column="1" Text="Codex 正在工作"
                                   FontWeight="SemiBold" Foreground="#292A28" FontSize="13" />
                        <Border Grid.Column="2" Background="#E5E1DA" BorderBrush="#A7ADB0"
                                BorderThickness="1" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="GUGU" Foreground="#6B6E6D" FontSize="8" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border x:Name="BubbleAccentBar" Height="3" Background="{StaticResource BubbleCyan}"
                            CornerRadius="2" Margin="0,8,0,8" />

                    <TextBlock x:Name="TaskTitleText" TextWrapping="Wrap"
                               FontWeight="SemiBold" FontSize="12" Foreground="#292A28"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText" Margin="0,5,0,0" TextWrapping="Wrap"
                               MaxWidth="298" FontSize="12" Foreground="#575651" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TaskNavigation" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="‹" Width="27" Height="24" Padding="0" Click="PreviousTask_OnClick" />
                            <TextBlock x:Name="TaskCounterText" Margin="7,0" VerticalAlignment="Center"
                                       FontSize="10" Foreground="#77736D" />
                            <Button Content="›" Width="27" Height="24" Padding="0" Click="NextTask_OnClick" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="点击气泡返回 Codex" Margin="9,0"
                                   VerticalAlignment="Center" FontSize="10" Foreground="#817D76" />
                        <Button x:Name="ActionButton" Grid.Column="2" Content="返回 Codex"
                                Visibility="Collapsed" Padding="11,5" Foreground="White"
                                Background="{StaticResource BubbleOrange}" BorderBrush="#DF8D15"
                                FontWeight="SemiBold" Click="ActionButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Column="0" Width="104" Height="116" Margin="0,0,-26,-2"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background>
                <ImageBrush ImageSource="Assets/gugu-icon-cutout.png" Stretch="UniformToFill"
                            Viewbox="0.18,0,0.64,0.76" ViewboxUnits="RelativeToBoundingBox" AlignmentY="Top" />
            </Border.Background>
        </Border>

        <Path Grid.Row="1" Grid.Column="1" Fill="{StaticResource BubbleInk}"
              Data="M 155,0 L 183,0 L 169,14 Z" HorizontalAlignment="Left" Margin="72,-1,0,0" />
        <Path Grid.Row="1" Grid.Column="1" Fill="{StaticResource BubbleOrange}"
              Data="M 159,0 L 179,0 L 169,10 Z" HorizontalAlignment="Left" Margin="72,-1,0,0" />
    </Grid>
</Window>
