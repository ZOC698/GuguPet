<Window x:Class="GuguPet.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咕嘎桌宠控制台"
        Width="540" Height="820"
        MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#292A28" />
        <SolidColorBrush x:Key="InkSoft" Color="#3A3B38" />
        <SolidColorBrush x:Key="Cream" Color="#FFFDF8" />
        <SolidColorBrush x:Key="Belly" Color="#FFF9F0" />
        <SolidColorBrush x:Key="Orange" Color="#F5A623" />
        <SolidColorBrush x:Key="OrangeHover" Color="#FFB84C" />
        <SolidColorBrush x:Key="Cyan" Color="#26AFC2" />
        <SolidColorBrush x:Key="Silver" Color="#BBC1C5" />
        <SolidColorBrush x:Key="Line" Color="#DDD8CF" />
        <SolidColorBrush x:Key="Text" Color="#292A28" />
        <SolidColorBrush x:Key="Muted" Color="#716D67" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="BorderBrush" Value="#D6D0C7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Orange}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3DC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE4AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Orange}" />
            <Setter Property="BorderBrush" Value="#E18B10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B4493E" />
            <Setter Property="BorderBrush" Value="#E8B9B3" />
            <Setter Property="Background" Value="#FFF5F3" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="5"
                                    Background="#FFFDF9" BorderBrush="#B9B4AC" BorderThickness="1.2"
                                    Margin="0,0,8,0">
                                <Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="White"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Cyan}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#168FA0" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Orange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="BorderBrush" Value="#D6D0C7" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Orange}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#DED9D0" />
            <Setter Property="Background" Value="#FFFCF7" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E9F8FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#D8F2F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Belly}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Ink}" BorderBrush="#171817" BorderThickness="1"
            CornerRadius="25" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="76" Height="76" CornerRadius="38" Margin="16,16,0,12"
                        BorderBrush="#D9EDF1" BorderThickness="2">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/gugu-icon-cutout.png" Stretch="UniformToFill"
                                    Viewbox="0.22,0,0.56,0.58" ViewboxUnits="RelativeToBoundingBox" AlignmentY="Top" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,23,8,0">
                    <TextBlock Text="咕嘎桌宠" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Codex Pet v2 · 咕嘎控制中心" Foreground="#BFC3C2" FontSize="11" Margin="1,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="1,9,0,0">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="{StaticResource Cyan}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderStatusText" Text="待机中" Foreground="#EDEAE4" FontSize="11" Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,14,14,0">
                    <Button Content="—" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Foreground="#D7D7D5" Background="#343533" BorderBrush="#50514E"
                            Click="MinimizeControl_OnClick" />
                    <Button Content="×" Width="34" Height="30" Padding="0"
                            Foreground="#D7D7D5" Background="#343533" BorderBrush="#50514E"
                            FontSize="17" Click="HideControl_OnClick" />
                </StackPanel>

                <Canvas Grid.Column="2" IsHitTestVisible="False" Width="86" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8" Opacity="0.9">
                    <Ellipse Width="14" Height="20" Fill="#F7F5ED" Canvas.Left="8" Canvas.Top="3" />
                    <Ellipse Width="6" Height="10" Fill="#262725" Canvas.Left="12" Canvas.Top="8" />
                    <Ellipse Width="14" Height="20" Fill="#F7F5ED" Canvas.Left="62" Canvas.Top="3" />
                    <Ellipse Width="6" Height="10" Fill="#262725" Canvas.Left="66" Canvas.Top="8" />
                    <Path Fill="{StaticResource Orange}" Data="M 28,22 L 56,22 L 42,34 Z" />
                </Canvas>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Cream}" CornerRadius="21,21,24,24" Margin="7,0,7,7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,11,14">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="27" Height="27" CornerRadius="14" Background="{StaticResource Ink}" Margin="0,0,9,0">
                                        <TextBlock Text="●" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="动作状态" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ComboBox x:Name="StateCombo" Margin="0,0,0,10" SelectionChanged="StateCombo_OnSelectionChanged" />
                                <WrapPanel>
                                    <Button Content="挥手" Click="Wave_OnClick" Margin="0,0,8,0" />
                                    <Button Content="跳跃" Click="Jump_OnClick" Margin="0,0,8,0" />
                                    <Button Content="回到待机" Click="Idle_OnClick" Style="{StaticResource PrimaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="★  扩展动作" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Button Content="胜利欢呼" Tag="celebrate-cheer" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="开心鼓掌" Tag="celebrate-clap" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="企鹅摇摆舞" Tag="celebrate-dance" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="弹吉他" Tag="guitar" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="投喂饼干" Tag="cookie" Click="FeedCookie_OnClick" Margin="0,0,8,8" />
                                    <Button x:Name="CookieDragButton" Content="拖动饼干 🍪" Margin="0,0,8,8"
                                            PreviewMouseLeftButtonDown="CookieDragButton_OnMouseDown"
                                            PreviewMouseMove="CookieDragButton_OnMouseMove" />
                                    <Button Content="侧睡" Tag="sleep-side" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="趴窝" Tag="sleep-prone" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="仰睡" Tag="sleep-supine" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="需要输入" Tag="needs-input" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="喝水" Tag="drink" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="伸懒腰" Tag="stretch" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="坐着思考" Tag="sit-think" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="摸头反应" Tag="head-pat" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                    <Button Content="护肚反应" Tag="belly-poke" Click="IdleAction_OnClick" Margin="0,0,8,8" />
                                </WrapPanel>
                                <CheckBox x:Name="AutoIdleActionsCheck" Content="待机时随机播放扩展动作" IsChecked="True"
                                          Checked="AutoIdleActionsCheck_OnChanged" Unchecked="AutoIdleActionsCheck_OnChanged" Margin="0,4,0,0" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="IdleIntervalSlider" Minimum="15" Maximum="180" Value="45" TickFrequency="15"
                                            ValueChanged="IdleIntervalSlider_OnValueChanged" />
                                    <TextBlock x:Name="IdleIntervalValue" Grid.Column="1" Text="45 秒" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◆  桌面漫游" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="测试边缘" Click="EdgeActionNow_OnClick" Padding="10,5" Margin="0,0,7,0" />
                                        <Button Content="立即走动" Click="RoamNow_OnClick" Padding="10,5" Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                </DockPanel>
                                <CheckBox x:Name="AutoRoamCheck" Content="让咕嘎在桌面随机走动" IsChecked="True"
                                          Checked="AutoRoamCheck_OnChanged" Unchecked="AutoRoamCheck_OnChanged" />
                                <TextBlock Text="每次待机约 4–10 秒后选择新位置；交互或 Codex 工作状态会立即打断。"
                                           Style="{StaticResource Hint}" Margin="27,5,0,8" />
                                <CheckBox x:Name="ChaseCursorCheck" Content="快速移动鼠标时尝试追逐（默认关闭）"
                                          Checked="ChaseCursorCheck_OnChanged" Unchecked="ChaseCursorCheck_OnChanged" Margin="0,3" />
                                <CheckBox x:Name="EdgeActionsCheck" Content="偶尔去屏幕边缘探头、趴窝再爬回来"
                                          IsChecked="True" Checked="EdgeActionsCheck_OnChanged" Unchecked="EdgeActionsCheck_OnChanged" Margin="0,5,0,3" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="RoamSpeedSlider" Minimum="30" Maximum="180" Value="72" TickFrequency="10"
                                            ValueChanged="RoamSpeedSlider_OnValueChanged" />
                                    <TextBlock x:Name="RoamSpeedValue" Grid.Column="1" Text="72 px/s" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="◉  显示与注视" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示尺寸" VerticalAlignment="Center" />
                                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="80" Maximum="448" Value="180" TickFrequency="8" ValueChanged="SizeSlider_OnValueChanged" />
                                    <TextBlock x:Name="SizeValue" Grid.Column="2" Text="180 px" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="播放速度" VerticalAlignment="Center" />
                                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" ValueChanged="SpeedSlider_OnValueChanged" />
                                    <TextBlock x:Name="SpeedValue" Grid.Column="2" Text="1.00×" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,9,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.2" Maximum="1" Value="1" TickFrequency="0.1" ValueChanged="OpacitySlider_OnValueChanged" />
                                    <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox x:Name="GazeCheck" Content="跟随鼠标方向注视（16 方向）" IsChecked="True"
                                          Checked="GazeCheck_OnChanged" Unchecked="GazeCheck_OnChanged" />
                                <Grid Margin="27,7,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="GazeHoldSlider" Minimum="0.4" Maximum="4" Value="1.5" TickFrequency="0.2"
                                            ValueChanged="GazeHoldSlider_OnValueChanged" />
                                    <TextBlock x:Name="GazeHoldValue" Grid.Column="1" Text="1.5 秒" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="注视只在静止待机时生效；鼠标停止移动后自动恢复待机动画。"
                                           Style="{StaticResource Hint}" Margin="27,0,0,7" />
                                <WrapPanel Margin="0,5,0,0">
                                    <CheckBox x:Name="TopmostCheck" Content="始终置顶" IsChecked="True"
                                              Checked="TopmostCheck_OnChanged" Unchecked="TopmostCheck_OnChanged" Margin="0,0,22,0" />
                                    <CheckBox x:Name="ReducedMotionCheck" Content="减少动态效果"
                                              Checked="ReducedMotionCheck_OnChanged" Unchecked="ReducedMotionCheck_OnChanged" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Codex 状态" Style="{StaticResource SectionTitle}" Margin="0" />
                                    </StackPanel>
                                    <CheckBox x:Name="CodexSyncCheck" Content="自动同步" IsChecked="True" FontWeight="SemiBold" DockPanel.Dock="Right"
                                              Checked="CodexSyncCheck_OnChanged" Unchecked="CodexSyncCheck_OnChanged" />
                                </DockPanel>
                                <Border Background="#F0FAFB" BorderBrush="#C5E8EC" BorderThickness="1" CornerRadius="10" Padding="11">
                                    <TextBlock x:Name="CodexStatus" Text="正在连接 Codex 状态" TextWrapping="Wrap" />
                                </Border>
                                <CheckBox x:Name="ActivityBubbleCheck" Content="在咕嘎旁显示实时进度气泡" IsChecked="True"
                                          Checked="ActivityBubbleCheck_OnChanged" Unchecked="ActivityBubbleCheck_OnChanged" Margin="0,11,0,0" />
                                <Grid Margin="27,7,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="BubbleDurationSlider" Minimum="3" Maximum="30" Value="10" TickFrequency="1"
                                            ValueChanged="BubbleDurationSlider_OnValueChanged" />
                                    <TextBlock x:Name="BubbleDurationValue" Grid.Column="1" Text="10 秒" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="最近任务" FontWeight="SemiBold" Margin="0,5,0,7" />
                                <ListBox x:Name="TaskList" Height="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="TaskList_OnMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E4DED5" BorderThickness="0,0,0,1" Padding="9">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="10" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="38" Foreground="{StaticResource Muted}" Margin="0,3,0,0" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Margin="0,9,0,0">
                                    <Button Content="新建 Codex 任务" Click="NewCodexTask_OnClick" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" />
                                    <TextBlock Text="点击任务可返回 Codex" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="▶  咕嘎登场动画" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="StartupAnimationCheck" Content="启动咕嘎程序时播放猫眼登场"
                                          Checked="StartupAnimationCheck_OnChanged" Unchecked="StartupAnimationCheck_OnChanged" />
                                <CheckBox x:Name="ShowControlOnLaunchCheck" Content="启动咕嘎程序时同时显示控制台" Margin="0,8,0,0"
                                          Checked="ShowControlOnLaunchCheck_OnChanged" Unchecked="ShowControlOnLaunchCheck_OnChanged" />
                                <Button Content="预览咕嘎登场" Click="PreviewStartup_OnClick" HorizontalAlignment="Left"
                                        Margin="27,10,0,5" Style="{StaticResource PrimaryButton}" />
                                <TextBlock Text="默认只播放登场并显示咕嘎，不弹出控制台；右键咕嘎或双击托盘图标仍可打开。按 Esc 可跳过动画。"
                                           Style="{StaticResource Hint}" Margin="27,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="⚙  系统集成" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动咕嘎"
                                          Checked="StartupCheck_OnChanged" Unchecked="StartupCheck_OnChanged" />
                                <CheckBox x:Name="CodexStartupCheck" Content="随 Codex 启动咕嘎" Margin="0,8,0,0"
                                          Checked="CodexStartupCheck_OnChanged" Unchecked="CodexStartupCheck_OnChanged" />
                                <TextBlock x:Name="CodexStartupHint"
                                           Text="启用后注册事件驱动的隐藏监听器，不写入 Codex Hook，也不进行定时轮询。"
                                           Style="{StaticResource Hint}" Margin="27,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="控制台关闭后咕嘎仍留在托盘；托盘菜单可投喂、暂停走动或退出。"
                                           Style="{StaticResource Hint}" Margin="27,5,0,0" />
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语言" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="210"
                                              SelectionChanged="LanguageCombo_OnSelectionChanged" />
                                </Grid>
                                <TextBlock x:Name="LanguageRestartHint" Text="更改语言后重启咕嘎生效。"
                                           Style="{StaticResource Hint}" Margin="86,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="⌁  本地状态桥接" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="编辑本地数据目录内的 bridge-state.json，可让其他程序即时切换动作。"
                                           Style="{StaticResource Hint}" />
                                <Border Background="#F4F1EB" CornerRadius="8" Padding="10" Margin="0,8,0,8">
                                    <TextBlock x:Name="BridgeStatus" Text="等待状态更新" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                </Border>
                                <Button Content="打开状态目录" Click="OpenFolder_OnClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="操作：单击头部摸头，双击肚子触发护肚反应；可拖动饼干投喂；拖动咕嘎后会带一点惯性；右键打开菜单。"
                                   Style="{StaticResource Hint}" Margin="4,0,4,12" />
                        <Button Content="退出咕嘎桌宠" Click="Exit_OnClick" Style="{StaticResource DangerButton}" Margin="0,0,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
